# -----------------------------------------------------------------------------
# Backend configuration. Copy to backend/.env and fill in.
#
#   cp .env.example .env
#
# Spring reads this file as a properties file (see spring.config.import in
# application.yml). Real environment variables take precedence over it, so CI
# and containers can override anything here without editing the file.
#
# Format rules, because this is parsed as a .properties file and not by a shell:
#   - No `export`, no `$VAR` expansion, no command substitution.
#   - Do NOT quote values. Quotes become part of the value.
#   - `#` starts a comment only at the beginning of a line.
#   - Backslashes must be doubled (`C:\\path`), and `:` or `=` inside a KEY
#     must be escaped. Values may contain them freely.
#
# This file is gitignored. Never commit a real key.
# -----------------------------------------------------------------------------

# --- Required for free-form order parsing ------------------------------------
# Get one at https://console.anthropic.com/settings/keys
# Leave blank to run without AI: the app starts, /api/orders/parse returns a
# clean 503, and manual order entry plus the whole optimizer still work.
ANTHROPIC_API_KEY=

# --- Optional overrides -------------------------------------------------------
# Uncomment only what you want to change; defaults live in application.yml.

# HTTP port the backend listens on.
#server.port=8080

# Model used for extraction. max-tokens covers thinking AND the JSON answer on
# claude-opus-5, so do not drop it below ~4000.
#app.ai.model=claude-opus-5
#app.ai.max-tokens=8000

# Nominatim's usage policy REQUIRES an identifying User-Agent. Change this to
# something that names your project and gives them a way to contact you.
#app.geocoding.user-agent=route-optimizer/0.1 (you@example.com)
# ISO country codes to bias geocoding towards. Blank searches worldwide.
#app.geocoding.country-codes=mx
# Nominatim allows at most one request per second.
#app.geocoding.min-interval-millis=1100

# Distance matrix: `haversine` (offline approximation) or `osrm` (real roads).
#app.routing.matrix=haversine
# Point this at your own OSRM instance for production; the demo server is
# rate-limited and unsuitable for real traffic.
#app.routing.osrm.base-url=https://router.project-osrm.org

# Optimizer tuning. Penalties are expressed in metres so they stay comparable
# with distance: 500 means one minute late costs as much as a 500 m detour.
#app.routing.detour-factor=1.3
#app.routing.average-speed-kmh=30
#app.routing.late-penalty-per-minute=500
#app.routing.priority-penalty-per-position=200

# Where the Angular dev server runs, for CORS.
#app.cors.allowed-origins=http://localhost:4200
