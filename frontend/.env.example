# -----------------------------------------------------------------------------
# Frontend dev-server configuration. Copy to frontend/.env and fill in.
#
#   cp .env.example .env
#
# Read by proxy.conf.js at `npm start`. It only affects the local dev server —
# a production build serves from wherever you host it, so nothing here is
# baked into the bundle.
#
# NEVER put an API key in this file. Anything the frontend can read, so can
# anyone who opens devtools. The Anthropic key belongs in backend/.env only.
# -----------------------------------------------------------------------------

# Where the Spring Boot backend is listening. Must match the backend's
# server.port — change it here too if you set server.port in backend/.env.
BACKEND_URL=http://localhost:8080
